# =========================================================
# .env.example — скопіюй у .env і заповни реальними значеннями
# НІКОЛИ не комітити .env у git!
# =========================================================

# ── GrowthBook ──────────────────────────────────────────
# Адмін-токен (Admin API). Генерується в GrowthBook → Settings → API Keys
GB_ADMIN_TOKEN=gbsec_your_admin_token_here

# SDK-ключ для клієнтського браузерного SDK (read-only)
GB_CLIENT_KEY_PUBLIC=gbpk_your_sdk_key_here

# Публічна адреса GrowthBook API (куди ходить браузер за фічами)
# Локально: http://localhost:3100
# На сервері з HTTPS: https://growthappai.duckdns.org  (Nginx проксює /api/v1/ → growthbook:3100)
GB_PUBLIC_API_HOST=https://growthappai.duckdns.org

# Публічна адреса GrowthBook UI (APP_ORIGIN)
# Локально: http://localhost:3000
# На сервері: http://<DROPLET_IP>:3000
GB_APP_ORIGIN=http://localhost:3000

# Публічна адреса GrowthBook API для браузера (API_HOST)
# Локально: http://localhost:3100
# На сервері: http://<DROPLET_IP>:3100
GB_API_HOST=http://localhost:3100

# Домен (для Nginx/certbot)
DOMAIN=growthappai.duckdns.org

# Власник/автор у GrowthBook (відображається в UI)
GB_OWNER=Vitaliy

# Назва проекту в GrowthBook
GB_PROJECT=My First Project

# ── GrowthBook internal secrets ─────────────────────────
# Генеруй через: openssl rand -base64 32
GB_ENCRYPTION_KEY=your_encryption_key_here
GB_JWT_SECRET=your_jwt_secret_here

# ── PostgreSQL (події/аналітика) ────────────────────────
DB_URL=jdbc:postgresql://events-postgres:5432/gb_events
DB_USERNAME=gb_user
DB_PASSWORD=your_strong_db_password_here

# ── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Spring ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
